# Server — use one port for Express + Vite (middleware mode)
PORT=8788
# Bind address (0.0.0.0 = all interfaces; use 127.0.0.1 to restrict to localhost)
HOST=0.0.0.0

# Admin seed (created on first DB init)
ADMIN_EMAIL=admin@shieldpay.local
ADMIN_PASSWORD=ChangeMeAdmin!234

# Required secrets (≥32 chars each). Generate e.g. openssl rand -hex 32
JWT_SECRET=
SESSION_SECRET=

# AES-256 field encryption (exactly 64 hex chars = 32 bytes). openssl rand -hex 32
FIELD_ENCRYPTION_KEY=

# SQLite database file (created automatically)
DATABASE_PATH=./backend/data/shieldpay.db

# Demo only: log password-reset opaque tokens to server console (never enable in production)
# SHIELDPAY_LOG_RESET_TOKENS=1
